[
    // ==========================================
    // 1. AMBIENTI E MODALITÀ MATEMATICA
    // ==========================================
    {trigger: "mk", replacement: "$$0$", options: "tA", description: "Inline math"},
    {trigger: "dm", replacement: "$$\n$0\n$$", options: "tAw", description: "Display math"},
    {trigger: "beg", replacement: "\\begin{$0}\n$1\n\\end{$0}", options: "mA", description: "Ambiente generico"},
    {trigger: "ds", replacement: "\\displaystyle", options: "mA"},
    {trigger: "text", replacement: "\\text{$0}$1", options: "mA"},
    {trigger: "\"", replacement: "\\text{$0}$1", options: "mA"},

    // ==========================================
    // 2. LETTERE GRECHE E SIMBOLI
    // ==========================================
    {trigger: "@a", replacement: "\\alpha", options: "mA"},
    {trigger: "@b", replacement: "\\beta", options: "mA"},
    {trigger: "@g", replacement: "\\gamma", options: "mA"},
    {trigger: "@G", replacement: "\\Gamma", options: "mA"},
    {trigger: ":d", replacement: "\\delta", options: "mA"},
    {trigger: ":D", replacement: "\\Delta", options: "mA"},
    {trigger: "@e", replacement: "\\varepsilon", options: "mA", description: "Sempre varepsilon"},
    {trigger: ":e", replacement: "\\varepsilon", options: "mA", description: "Sempre varepsilon"},
    {trigger: ":f", replacement: "\\varphi", options: "mA"},
    {trigger: "@z", replacement: "\\zeta", options: "mA"},
    {trigger: "@t", replacement: "\\vartheta", options: "mA"},
    {trigger: "@T", replacement: "\\Theta", options: "mA"},
    {trigger: ":t", replacement: "\\theta", options: "mA"},
    {trigger: "@i", replacement: "\\iota", options: "mA"},
    {trigger: "@k", replacement: "\\kappa", options: "mA"},
    {trigger: "@l", replacement: "\\lambda", options: "mA"},
    {trigger: "@L", replacement: "\\Lambda", options: "mA"},
    {trigger: "@s", replacement: "\\sigma", options: "mA"},
    {trigger: "@S", replacement: "\\Sigma", options: "mA"},
    {trigger: "@u", replacement: "\\upsilon", options: "mA"},
    {trigger: "@U", replacement: "\\Upsilon", options: "mA"},
    {trigger: "@o", replacement: "\\omega", options: "mA"},
    {trigger: "@O", replacement: "\\Omega", options: "mA"},
    {trigger: "e\\xi sts", replacement: "\\exists", options: "mA", priority: 1, description: "Evita bug xi"},
    
    // ==========================================
    // 3. OPERAZIONI DI BASE E INDICI
    // ==========================================
    {trigger: "sr", replacement: "^{2}", options: "mA", description: "Quadrato"},
    {trigger: "cb", replacement: "^{3}", options: "mA", description: "Cubo"},
    {trigger: "^", replacement: "^{$0}$1", options: "mA", description: "Apice generico"},
    {trigger: "_", replacement: "_{$0}$1", options: "mA", description: "Pedice generico"},
    {trigger: "sts", replacement: "_\\text{$0}", options: "mA", description: "Pedice testuale"},
    {trigger: "sq", replacement: "\\sqrt{ $0 }$1", options: "mA"},
    {trigger: "ee", replacement: "e^{ $0 }$1", options: "mA"},
    {trigger: "invs", replacement: "^{-1}", options: "mA", description: "Inversa"},
    {trigger: "tc", replacement:"\\, | \\,", options:"mA", description: "Separatore insiemi (|)"},
    {trigger: "xx", replacement: "\\times", options: "mA", description: "Per / Prodotto cartesiano"},
    {trigger: "**", replacement: "\\cdot", options: "mA", description: "Punto moltiplicazione"},
    {trigger: "+-", replacement: "\\pm", options: "mA"},
    {trigger: "-+", replacement: "\\mp", options: "mA"},
    {trigger: "...", replacement: "\\dots", options: "mA"},

    // ==========================================
    // 4. GRANDI OPERATORI (Senza ds automatico)
    // ==========================================
    {trigger: "sum", replacement: "\\sum", options: "mA"},
    {trigger: "\\sum", replacement: "\\sum_{${0:i}=${1:1}}^{${2:N}} $3", options: "m"},
    {trigger: "prod", replacement: "\\prod", options: "mA"},
    {trigger: "\\prod", replacement: "\\prod_{${0:i}=${1:1}}^{${2:N}} $3", options: "m"},
    {trigger: "lim", replacement: "\\lim_{ ${0:n} \\to ${1:\\infty} } $2", options: "mA"},
    {trigger: "llim", replacement: "\\limits", options: "mA"},
    {trigger: "bcup", replacement: "\\bigcup", options: "mA"},
    {trigger: "bcap", replacement: "\\bigcap", options: "mA"},

    // ==========================================
    // 5. CALCOLO E INTEGRALI
    // ==========================================
    {trigger: /([^\\])int/, replacement: "[[0]]\\int", options: "mA", priority: -1},
    {trigger: "\\int", replacement: "\\int $0 \\, d${1:x} $2", options: "m"},
    {trigger: "dint", replacement: "\\int_{${0:0}}^{${1:1}} $2 \\, d${3:x} $4", options: "mA"},
    {trigger: "oint", replacement: "\\oint", options: "mA"},
    {trigger: "iint", replacement: "\\iint", options: "mA"},
    {trigger: "iiint", replacement: "\\iiint", options: "mA"},
    {trigger: "oinf", replacement: "\\int_{0}^{\\infty} $0 \\, d${1:x} $2", options: "mA"},
    {trigger: "infi", replacement: "\\int_{-\\infty}^{\\infty} $0 \\, d${1:x} $2", options: "mA"},
    {trigger: "par", replacement: "\\frac{ \\partial ${0:y} }{ \\partial ${1:x} } $2", options: "m"},
    {trigger: /pa([A-Za-z])([A-Za-z])/, replacement: "\\frac{ \\partial [[0]] }{ \\partial [[1]] } ", options: "rm"},
    {trigger: "ddt", replacement: "\\frac{d}{dt} ", options: "mA"},
    {trigger: "nabl", replacement: "\\nabla", options: "mA"},
    {trigger: "del", replacement: "\\nabla", options: "mA"},

    // ==========================================
    // 6. LOGARITMI, ESPONENZIALI E TRIGONOMETRIA
    // ==========================================
    {trigger: /([^\\])(exp|log|ln)/, replacement: "[[0]]\\[[1]]", options: "rmA"},
    {trigger: /([^\\])(arcsin|sin|arccos|cos|arctan|tan|csc|sec|cot)/, replacement: "[[0]]\\[[1]]", options: "rmA"},
    {trigger: /\\(arcsin|sin|arccos|cos|arctan|tan|csc|sec|cot)([A-Za-gi-z])/, replacement: "\\[[0]] [[1]]", options: "rmA"},
    {trigger: /\\(sinh|cosh|tanh|coth)([A-Za-z])/, replacement: "\\[[0]] [[1]]", options: "rmA"},

    // ==========================================
    // 7. ALGEBRA E INSIEMISTICA
    // ==========================================
    {trigger: /([^\\])(det)/, replacement: "[[0]]\\[[1]]", options: "rmA"},
    {trigger: "trace", replacement: "\\mathrm{Tr}", options: "mA"},
    {trigger: "conj", replacement: "^{*}", options: "mA"},
    {trigger: "Re", replacement: "\\mathrm{Re}", options: "mA"},
    {trigger: "Im", replacement: "\\mathrm{Im}", options: "mA"},
    {trigger: "cap", replacement: "\\cap", options: "mA"},
    {trigger: "cup", replacement: "\\cup", options: "mA"},
    {trigger: "scup", replacement: "\\sqcup", options: "mA"},
    {trigger: "inn", replacement: "\\in", options: "mA"},
    {trigger: "notin", replacement: "\\not\\in", options: "mA"},
    {trigger: "\\sm", replacement: "\\setminus", options: "mA"},
    {trigger: "sub=", replacement: "\\subseteq", options: "mA"},
    {trigger: "sup=", replacement: "\\supseteq", options: "mA"},
    {trigger: "eset", replacement: "\\emptyset", options: "mA"},
    {trigger: "empty", replacement: "\\varnothing", options: "mA"},
    {trigger: "set", replacement: "\\{ $0 \\}$1", options: "mA"},
    {trigger: "ooo", replacement: "\\infty", options: "mA"},
    {trigger: "sup", replacement: "\\sup\\{ $0 \\}", options: "mA"},
    {trigger: "inf", replacement: "\\inf\\{ $0 \\}", options: "mA"},
    {trigger: "max", replacement: "\\max\\{ $0 \\}", options: "mA"},
    {trigger: "min", replacement: "\\min\\{ $0 \\}", options: "mA"},
    {trigger: "<|", replacement: "\\lhd", options: "mA", description: "Sottogruppo normale"},
    {trigger: "mod", replacement: "\\text{ mod }", options: "mA"},

    // ==========================================
    // 8. RELAZIONI E FRECCE
    // ==========================================
    {trigger: "===", replacement: "\\equiv", options: "mA", description: "Equivalenza/Congruenza"},
    {trigger: "!=", replacement: "\\neq", options: "mA"},
    {trigger: ">=", replacement: "\\geq", options: "mA"},
    {trigger: "<=", replacement: "\\leq", options: "mA"},
    {trigger: ">>", replacement: "\\gg", options: "mA"},
    {trigger: "<<", replacement: "\\ll", options: "mA"},
    {trigger: "~~", replacement: "\\sim", options: "mA"},
    {trigger: "~=", replacement: "\\simeq", options: "mA"},
    {trigger: "\\simeq=", replacement: "\\cong", options: "mA"},
    {trigger: "prop", replacement: "\\propto", options: "mA"},
    {trigger: "->", replacement: "\\to", options: "mA"},
    {trigger: "<->", replacement: "\\leftrightarrow ", options: "mA"},
    {trigger: "!>", replacement: "\\longmapsto", options: "mA"},
    {trigger: "=>", replacement: "\\implies", options: "mA"},
    {trigger: "=<", replacement: "\\impliedby", options: "mA"},
    {trigger: "c>", replacement: "\\hookrightarrow", options:"mA"},
    {trigger: ">->", replacement: "\\twoheadrightarrow", options:"mA"},
    {trigger: "&&", replacement: "\\,\\wedge\\,", options: "mA", description: "AND logico"},
    {trigger: "||", replacement: "\\,\\vee\\,", options: "mA", description: "OR logico"},

    // ==========================================
    // 9. MODIFICATORI E ACCENTI
    // ==========================================
    {trigger: "hat", replacement: "\\hat{$0}$1", options: "mA"},
    {trigger: "over", replacement: "\\overline{$0}$1", options: "mA"},
    {trigger: "ost", replacement: "\\overset{$0}{$1}", options: "mA"},
    {trigger: "ust", replacement: "\\underset{$0}{$1}", options: "mA"},
    {trigger: "dot", replacement: "\\dot{$0}$1", options: "mA", priority: -1},
    {trigger: "ddot", replacement: "\\ddot{$0}$1", options: "mA"},
    {trigger: "cdot", replacement: "\\cdot", options: "mA"},
    {trigger: "tilde", replacement: "\\widetilde{$0}$1", options: "mA"},
    {trigger: "und", replacement: "\\underline{$0}$1", options: "mA"},
    {trigger: "vec", replacement: "\\vec{$0}$1", options: "mA"},
    {trigger: "bf", replacement: "\\mathbf{$0}", options: "mA"},
    {trigger: "cal", replacement: "\\mathcal{$0}", options: "mA"},
    {trigger: "rm", replacement: "\\mathrm{$0}$1", options: "mA"},

    // Modificatori RegEx automatici (es. Ahat -> \hat{A})
    {trigger: "([a-zA-Z])hat", replacement: "\\hat{[[0]]}", options: "rmA"},
    {trigger: "([a-zA-Z])bar", replacement: "\\bar{[[0]]}", options: "rmA"},
    {trigger: "([a-zA-Z])dot", replacement: "\\dot{[[0]]}", options: "rmA", priority: -1},
    {trigger: "([a-zA-Z])ddot", replacement: "\\ddot{[[0]]}", options: "rmA", priority: 1},
    {trigger: "([a-zA-Z])tilde", replacement: "\\widetilde{[[0]]}", options: "rmA"},
    {trigger: "([a-zA-Z])und", replacement: "\\underline{[[0]]}", options: "rmA"},
    {trigger: "([a-zA-Z])vec", replacement: "\\vec{[[0]]}", options: "rmA"},
    {trigger: "([a-zA-Z]),\\.", replacement: "\\mathbf{[[0]]}", options: "rmA"},
    {trigger: "([a-zA-Z])\\.,", replacement: "\\mathbf{[[0]]}", options: "rmA"},

    // ==========================================
    // 10. SPAZI E INSIEMI NOTEVOLI
    // ==========================================
    {trigger: "LL", replacement: "\\mathcal{L}", options: "mA"},
    {trigger: "HH", replacement: "\\mathcal{H}", options: "mA"},
    {trigger: "CC", replacement: "\\mathbb{C}", options: "mA"},
    {trigger: "RR", replacement: "\\mathbb{R}", options: "mA"},
    {trigger: "ZZ", replacement: "\\mathbb{Z}", options: "mA"},
    {trigger: "NN", replacement: "\\mathbb{N}", options: "mA"},
    {trigger: "QQ", replacement: "\\mathbb{Q}", options: "mA"},
    {trigger: "TT", replacement: "\\mathbb{T}", options: "mA"},
    {trigger: "EE", replacement: "\\mathbb{E}", options: "mA"},
    {trigger: "Rl", replacement: "\\mathbb{R}_{\\ell}", options:"mA"},

    // ==========================================
    // 11. TOPOLOGIA E SPAZI METRICI
    // ==========================================
    {trigger: "homeo", replacement: "\\cong", options: "mA"},
    {trigger: "intt", replacement: "\\mathring{$0}$1", options: "mA"},
    {trigger: "bnd", replacement: "\\partial", options: "mA"},
    {trigger: "quot", replacement: "/\\sim", options: "mA"},
    {trigger: "clos", replacement: "\\overline{$0}$1", options: "mA"},
    {trigger: "top", replacement: "(${0:X}, \\tau_{$0})", options: "mA"},
    {trigger: "ball", replacement: "B_{${0:\\varepsilon}}(${1:x_{0}})", options: "mA"},
    {trigger: "cls", replacement: "[${0:x}]_{\\sim}", options: "mA"},

    // ==========================================
    // 12. FUNZIONI, LOGICA E TESTO
    // ==========================================
    {trigger: "x->", replacement: "\\xrightarrow{ $0 }", options: "mA"},
    {trigger: "mto", replacement: "\\mapsto", options: "mA"},
    {trigger: "circ", replacement: "\\circ", options: "mA"},
    {trigger: "ttc", replacement: "\\text{ t.c. }", options: "mA", description: "tale che"},
    {trigger: " se ", replacement: "\\text{ se }", options: "mA"},
    {trigger: " e ", replacement: "\\text{ e }", options: "mA"},
    {trigger: "iff", replacement: "\\iff", options: "mA"},
    {trigger: "tkcd", replacement: "\\begin{tikzcd}\n$0\n\\end{tikzcd}", options: "mA"},
    
    // Alternative per stmaryrd
    {trigger: "llr", replacement: "[\\![ $0 ]\\!] $1", options: "mA", description: "Doppie quadre semantica"},
    {trigger: "light", replacement: "\\unicode{x21AF}", options: "mA", description: "Contraddizione"},
    
    // Fix nativo per mapsfrom su Obsidian
    {trigger: "mfrom", replacement: "\\mathrel{\\dashv\\mathrel{\\mkern-6mu}\\leftarrow}", options: "mA", description: "Mapsfrom (fix Obsidian)"},
    {trigger: "lmfrom", replacement: "\\mathrel{\\dashv\\mathrel{\\mkern-6mu}\\longleftarrow}", options: "mA", description: "Long mapsfrom"},

    // ==========================================
    // 13. PARENTESI E DELIMITATORI
    // ==========================================
    {trigger: "avg", replacement: "\\langle $0 \\rangle $1", options: "mA"},
    {trigger: "norm", replacement: "\\lvert $0 \\rvert $1", options: "mA", priority: 1},
    {trigger: "Norm", replacement: "\\lVert $0 \\rVert $1", options: "mA", priority: 1},
    {trigger: "ceil", replacement: "\\lceil $0 \\rceil $1", options: "mA"},
    {trigger: "floor", replacement: "\\lfloor $0 \\rfloor $1", options: "mA"},
    {trigger: "vert", replacement: "\\, \\vert \\, ", options: "mA"},
    {trigger: "para", replacement: "\\parallel", options: "mA"},
    {trigger: "(", replacement: "($0)$1", options: "mA"},
    {trigger: "{", replacement: "{$0}$1", options: "mA"},
    {trigger: "[", replacement: "[$0]$1", options: "mA"},
    {trigger: "lr(", replacement: "\\left( $0 \\right) $1", options: "mA"},
    {trigger: "lr{", replacement: "\\left\\{ $0 \\right\\} $1", options: "mA"},
    {trigger: "lr[", replacement: "\\left[ $0 \\right] $1", options: "mA"},
    {trigger: "lr|", replacement: "\\left| $0 \\right| $1", options: "mA"},
    {trigger: "lra", replacement: "\\left< $0 \\right> $1", options: "mA"},

    // ==========================================
    // 14. MATRICI E AMBIENTI MULTIRIGA
    // ==========================================
    // Ambienti multiriga standard
    {trigger: "pmat", replacement: "\\begin{pmatrix}\n$0\n\\end{pmatrix}", options: "MA"},
    {trigger: "bmat", replacement: "\\begin{bmatrix}\n$0\n\\end{bmatrix}", options: "MA"},
    {trigger: "Bmat", replacement: "\\begin{Bmatrix}\n$0\n\\end{Bmatrix}", options: "MA"},
    {trigger: "vmat", replacement: "\\begin{vmatrix}\n$0\n\\end{vmatrix}", options: "MA"},
    {trigger: "Vmat", replacement: "\\begin{Vmatrix}\n$0\n\\end{Vmatrix}", options: "MA"},
    {trigger: "matrix", replacement: "\\begin{matrix}\n$0\n\\end{matrix}", options: "MA"},
    
    // Matrici inline compatte (nA)
    {trigger: "pmat", replacement: "\\begin{pmatrix}$0\\end{pmatrix}", options: "nA"},
    {trigger: "bmat", replacement: "\\begin{bmatrix}$0\\end{bmatrix}", options: "nA"},
    {trigger: "Bmat", replacement: "\\begin{Bmatrix}$0\\end{Bmatrix}", options: "nA"},
    {trigger: "vmat", replacement: "\\begin{vmatrix}$0\\end{vmatrix}", options: "nA"},
    {trigger: "Vmat", replacement: "\\begin{Vmatrix}$0\\end{Vmatrix}", options: "nA"},
    {trigger: "matrix", replacement: "\\begin{matrix}$0\\end{matrix}", options: "nA"},
    
    {trigger: "cases", replacement: "\\begin{cases}\n$0\n\\end{cases}", options: "mA"},
    {trigger: "align", replacement: "\\begin{align*}\n$0\n\\end{align*}", options: "mA"},
    {trigger: "array", replacement: "\\begin{array}\n$0\n\\end{array}", options: "mA"},

    {trigger: /iden(\d)/, replacement: (match) => {
        const n = match[1];
        let arr = [];
        for (let j = 0; j < n; j++) {
            arr[j] = [];
            for (let i = 0; i < n; i++) {
                arr[j][i] = (i === j) ? 1 : 0;
            }
        }
        let output = arr.map(el => el.join(" & ")).join(" \\\\\n");
        output = `\\begin{pmatrix}\n${output}\n\\end{pmatrix}`;
        return output;
    }, options: "mA", description: "Matrice identità NxN"},

    // ==========================================
    // 15. VARI (Operazioni Visuali, Sviluppi)
    // ==========================================
    {trigger: "U", replacement: "\\underbrace{ ${VISUAL} }_{ $0 }", options: "mA"},
    {trigger: "O", replacement: "\\overbrace{ ${VISUAL} }^{ $0 }", options: "mA"},
    {trigger: "B", replacement: "\\underset{ $0 }{ ${VISUAL} }", options: "mA", description: "Testo sotto la selezione"},
    {trigger: "C", replacement: "\\cancel{ ${VISUAL} }", options: "mA"},
    {trigger: "K", replacement: "\\cancelto{ $0 }{ ${VISUAL} }", options: "mA"},
    {trigger: "S", replacement: "\\sqrt{ ${VISUAL} }", options: "mA", description: "Radice sulla selezione"},
    {trigger: "sfrac", replacement: "{}^{$0}\\!/_{$1}", options: "mA", description: "Frazione diagonale sfalsata"},
    {trigger: "tayl", replacement: "${0:f}(${1:x} + ${2:h}) = ${0:f}(${1:x}) + ${0:f}'(${1:x})${2:h} + ${0:f}''(${1:x}) \\frac{${2:h}^{2}}{2!} + \\dots$3", options: "mA"},

    // ==========================================
    // 16. QUANTISTICA E FISICA (Dal tuo originale)
    // ==========================================
    {trigger: "dag", replacement: "^{\\dagger}", options: "mA"},
    {trigger: "o+", replacement: "\\oplus ", options: "mA"},
    {trigger: "ox", replacement: "\\otimes ", options: "mA"},
    {trigger: "bra", replacement: "\\bra{$0} $1", options: "mA"},
    {trigger: "ket", replacement: "\\ket{$0} $1", options: "mA"},
    {trigger: "brk", replacement: "\\braket{ $0 } $1", options: "mA"},
    {trigger: "outer", replacement: "\\ket{${0:\\psi}} \\bra{${0:\\psi}} $1", options: "mA"},

    // ==========================================
    // 17. AUTO-GREEK, SPAZI E AUTO-PEDICI
    // ==========================================
    // Auto-backslash per lettere greche e simboli scritti per intero
    {trigger: "([^\\\\])(${GREEK})", replacement: "[[0]]\\[[1]]", options: "rmA"},
    {trigger: "([^\\\\])(${SYMBOL})", replacement: "[[0]]\\[[1]]", options: "rmA"},

    // Gestione spazi intelligenti dopo simboli
    {trigger: "\\\\(${GREEK}|${SYMBOL}|${MORE_SYMBOLS})([A-Za-z])", replacement: "\\[[0]] [[1]]", options: "rmA"},
    
    // Auto-formattazione per simboli con esponenti e modificatori
    {trigger: "\\\\(${GREEK}|${SYMBOL}) sr", replacement: "\\[[0]]^{2}", options: "rmA"},
    {trigger: "\\\\(${GREEK}|${SYMBOL}) cb", replacement: "\\[[0]]^{3}", options: "rmA"},
    {trigger: "\\\\(${GREEK}|${SYMBOL}) rd", replacement: "\\[[0]]^{$0}$1", options: "rmA"},
    {trigger: "\\\\(${GREEK}|${SYMBOL}) hat", replacement: "\\hat{\\[[0]]}", options: "rmA"},
    {trigger: "\\\\(${GREEK}|${SYMBOL}) dot", replacement: "\\dot{\\[[0]]}", options: "rmA"},
    {trigger: "\\\\(${GREEK}|${SYMBOL}) bar", replacement: "\\bar{\\[[0]]}", options: "rmA"},
    {trigger: "\\\\(${GREEK}|${SYMBOL}) vec", replacement: "\\vec{\\[[0]]}", options: "rmA"},
    {trigger: "\\\\(${GREEK}|${SYMBOL}) tilde", replacement: "\\widetilde{\\[[0]]}", options: "rmA"},
    {trigger: "\\\\(${GREEK}|${SYMBOL}) und", replacement: "\\underline{\\[[0]]}", options: "rmA"},

    // Pedici comuni automatici (CORRETTI CON REGEX /.../)
    {trigger: /([A-Za-z])(\d)/, replacement: "[[0]]_{[[1]]}", options: "rmA", priority: -1},
    {trigger: "([a-zA-Z])(i|j|n|m|k|x|y)\\2{1}", replacement: "[[0]]_{[[1]]}", options: "rmA"},
    {trigger: "(${GREEK}) (i|j|n|m|k|x|y)\\2{1}", replacement: "[[0]]_{[[1]]}", options: "rmA"},
    
    // Modificatori seguiti da numero (CORRETTI CON REGEX /.../)
    {trigger: /\\hat{([A-Za-z])}(\d)/, replacement: "\\hat{[[0]]}_{[[1]]}", options: "rmA"},
    {trigger: /\\vec{([A-Za-z])}(\d)/, replacement: "\\vec{[[0]]}_{[[1]]}", options: "rmA"},
    {trigger: /\\mathbf{([A-Za-z])}(\d)/, replacement: "\\mathbf{[[0]]}_{[[1]]}", options: "rmA"},
    {trigger: /([A-Za-z])_(\d\d)/, replacement: "[[0]]_{[[1]]}", options: "rmA"},
    
    // Successivi veloci
    {trigger: "xp1", replacement: "x_{n+1}", options: "mA"}
]